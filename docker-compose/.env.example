# Public external URLs used by embedded widgets.
# Do not put secrets in this file.

EXTERNAL_BASE_URL=https://zemark-chat.pobuca.com
EXTERNAL_MQTT_BASE_URL=wss://zemark-chat.pobuca.com

# Logging
LOG_LEVEL=info

# Microsoft Entra / generic OAuth2.
OAUTH2_SIGNIN_ENABLED=false
OAUTH2_REDIRECT_URL=
OAUTH2_AUTH_URL=
OAUTH2_TOKEN_URL=
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_CALLBACK_URL=
OAUTH2_USER_INFO_URL=
OAUTH2_SCOPE=openid profile email
ALLOWED_ENTRA_TENANTS=
SESSION_SECRET=

# SMTP / email.
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_SECURE=
EMAIL_PORT=
EMAIL_FROM_ADDRESS=
DISABLE_SEND_OFFLINE_EMAIL=false

# Chat21 sync.
CHAT21_ADMIN_TOKEN=
SYNC_CHAT21_GROUPS=false
SYNC_JOIN_LEAVE_GROUP_EVENT=false

# RabbitMQ container bootstrap values.
RABBITMQ_ERLANG_COOKIE=
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=

# RAG / AI. Keep real keys only in .env or a secret manager.
GPTKEY=
